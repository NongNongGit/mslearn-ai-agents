kind: workflow
trigger:
  kind: OnConversationStart
  id: trigger_wf
  actions:
    - kind: SetVariable
      id: node-1790845108348
      variable: Local.SupportTickets
      value: |-
        =[ 
         "The API returns a 403 error when creating invoices, but our API key hasn't changed.", 
         "Is there a way to export all invoices as a CSV?", 
         "I was charged twice for the same invoice last Friday and my customer is also seeing two receipts. Can someone fix this?"]
    - kind: Foreach
      items: =Local.SupportTickets
      value: Local.CurrentTicket
      index: Local.LoopIndex_node_1790845378217
      actions:
        - kind: InvokeAzureAgent
          id: node-1790845497686
          agent:
            name: Triage-Agent
          conversationId: =System.ConversationId
          input:
            messages: =Local.CurrentTicket
          output:
            autoSend: true
            messages: Local.Var9391
            responseObject: Local.TriageOutputJson
      id: node-1790845378217
    - kind: ConditionGroup
      conditions:
        - condition: =Local.TriageOutputJson.confidence > 0.6
          actions:
            - kind: ConditionGroup
              conditions:
                - condition: =Local.TriageOutputJson.category = "Billing"
                  actions:
                    - kind: SendActivity
                      activity: Escalate billing issue to human support team.
                      id: node-1790846663017
                  id: if-node-1790846544760-4y1wsnfd
              id: node-1790846544760
              elseActions:
                - kind: InvokeAzureAgent
                  id: node-1790846708717
                  agent:
                    name: Resolution-Agent
                  conversationId: =System.ConversationId
                  input:
                    messages: =Local.TriageOutputText
                  output:
                    autoSend: true
                    messages: Local.ResolutionOutputText
          id: if-node-1790846268176-0bryr176
      id: node-1790846268176
      elseActions:
        - kind: SendActivity
          activity: 'The support ticket classification has low confidence. Requesting more details about the issue: "{Local.CurrentTicket}"'
          id: node-1790846390850
id: ""
name: ContosoPay-Customer-Support-Triage
description: ""
